POSTGRES_PASSWORD=falcon
FALCON_JWT_SECRET=please-change-this-secret-to-32-bytes-min
FALCON_WORKER_TOKEN=please-change-this-shared-secret
FALCON_ADMIN_EMAIL=admin@falcon.local
FALCON_ADMIN_PASSWORD=admin
VITE_API_URL=http://localhost:8080

# --- recon tunables ---
FALCON_KATANA_DEPTH=3
FALCON_KATANA_CONCURRENCY=10
FALCON_KATANA_PARALLELISM=10
